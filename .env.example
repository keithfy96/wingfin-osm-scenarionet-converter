# Settings for scripts/run-stages-1-3.sh, run-stages-4-6.sh and drive.sh.
# Copy to .env (gitignored) and edit. All three also take the workspace as a
# positional argument, which wins over WORKSPACE for that run.

# Which workspace the stage scripts operate on. A bare name is taken as
# workspaces/<name>; anything containing a "/" is used as the path as written.
WORKSPACE=mosque

# The versioned config both stages 2 and 4-6 are generated against.
CONFIG=config/default.yaml

# --- optional ---------------------------------------------------------------

# The Stage 3 export Stage 4 consumes. Defaults to <workspace>/review.json.
# REVIEW_SUBMISSION=workspaces/mosque/review.json

# Only ever supplied on the command line, so it is read back out of the workspace
# manifest. Set it here to override what the last acquisition recorded.
# DRIVING_SIDE=left

# 1 adds -v to every osm-scenario command.
# VERBOSE=0

# --- scripts/drive.sh only --------------------------------------------------

# The MetaDrive checkout's own interpreter. A different one from this repo's on
# purpose: MetaDrive is 3.8 / numpy 1.24 and this repo is 3.10 / numpy 2.2.
# METADRIVE_PYTHON=/home/keith/Desktop/work/wingfin/metadrive/.venv/bin/python

# Which card renders: auto (default) uses the discrete GPU when the machine has
# one, integrated forces the built-in graphics, nvidia insists. It cannot be a
# flag on drive.py -- the GLX loader settles it before python starts.
# GPU=auto

# Painted lane-line width in metres. MetaDrive's own thickness is in pixels, so
# its real width changes with the size of the map; this asks in metres instead.
# drive.py's own default (0.15, about a real road marking) applies when unset,
# and a --line-width-m after -- still wins over this. 0 uses MetaDrive's 2 px.
# LINE_WIDTH_M=0.15
