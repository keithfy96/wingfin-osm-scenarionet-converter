{
  "name": "osm-scenario-review-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Stage 3 review client. Build-time only; the installed CLI ships the compiled bundle and needs no Node.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
