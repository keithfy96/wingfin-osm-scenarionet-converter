.venv/
.env
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]
dist/
build/
#workspaces/

# Generated per run, by the pipeline and by the timing sweep. A step-timing CSV in
# particular is one file per run, stamped, and never overwritten -- so tracking them
# means the repo grows a file every time anyone measures anything.
workspaces/*/reports/
# Recorded drives (`drive.py --export-drive`). One directory per run, and a rig's 100000-step
# model drive is tens of megabytes of positions. They are also the one thing here that is
# *carried* between machines rather than rebuilt on each -- scp'd off the rig, watched once,
# and done with. Nothing downstream reads them.
workspaces/*/drives/
node_modules/

