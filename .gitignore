.venv/
.env
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]
dist/
build/
#workspaces/

# Generated per run, by the pipeline and by the timing sweep. A step-timing CSV in
# particular is one file per run, stamped, and never overwritten -- so tracking them
# means the repo grows a file every time anyone measures anything.
workspaces/*/reports/
# Recorded drives (`drive.py --export-drive`) are **tracked**, deliberately: the rig records and
# the laptop watches, and `git pull` is the transport rather than scp. Nothing downstream reads
# them -- they are carried, not rebuilt -- so the cost is history only. Worth knowing before
# adding one: a drive is about 1.1 MB per 3500 frames, a pickle of float arrays does not
# delta-compress, and a re-run into the same directory is a whole new blob rather than a diff.
# Commit the drives worth keeping, not every iteration.
# Keith's own recordings, for reading a bug back rather than for the pipeline. Unanchored, so
# it matches a `recordings/` at any depth rather than only in a workspace -- nothing here is
# generated into a directory of that name, so there is nothing for it to swallow by accident.
recordings/
node_modules/


# Throwaway git worktrees. `git worktree add .claude/worktrees/<name>` puts a whole second
# checkout here, and a `git add -A` from the root commits it as a **gitlink** (mode 160000)
# rather than as files -- a tracked path that points at a commit and breaks on any clone that
# has no such worktree. Happened once, in 3ec64b1.
.claude/worktrees/
